---
import { seed } from "../lib/seed";
import { clock, DAY_NAMES, loadTimetable, type MeetingView, type SessionView, weekOf, weekRanges } from "../lib/timetable";
import "../styles.css";

const { placements, choosing } = loadTimetable();
const year = Number(/\d{4}/.exec(seed.term)?.[0] ?? new Date().getFullYear());

const ERRORS: Record<string, string> = {
  full: "That session is full, so your timetable is unchanged.",
  "not-pickable": "You attend every session of that activity, so there is nothing to choose.",
  unknown: "That session isn't on offer, so your timetable is unchanged.",
};
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];

// The grid runs Monday to Friday, plus any weekend day something is on, over
// whole hours from the earliest start to the latest finish. One grid row is
// five minutes.
const placed = placements.map((p) => p.meeting);
const days = [1, 2, 3, 4, 5, 6, 7].filter((d) => d <= 5 || placed.some((m) => m.day === d));
const first = placed.length ? Math.floor(Math.min(...placed.map((m) => m.start)) / 60) * 60 : 9 * 60;
const last = placed.length ? Math.ceil(Math.max(...placed.map((m) => m.end)) / 60) * 60 : 17 * 60;
const rows = (last - first) / 5;
const hours = Array.from({ length: (last - first) / 60 }, (_, i) => first + i * 60);

// Sessions that overlap sit side by side in lanes rather than on top of each
// other, so a clash is visible as well as announced.
function lanes(day: number) {
  const ends: number[] = [];
  const onDay = placements
    .filter((p) => p.meeting.day === day)
    .map((p) => {
      let lane = ends.findIndex((end) => end <= p.meeting.start);
      if (lane === -1) lane = ends.length;
      ends[lane] = p.meeting.end;
      return { ...p, lane };
    });
  return { onDay, count: Math.max(1, ends.length) };
}

const when = (m: MeetingView) => `${DAY_NAMES[m.day - 1]} ${clock(m.start)}–${clock(m.end)}`;
// Where a session would sit on the grid, carried on its radio button so the
// page can preview a choice before it's saved. Kept out of the timetable
// itself: that region lists only what the student actually attends.
const preview = (s: SessionView) =>
  JSON.stringify(
    s.meetings.map((m) => ({
      day: m.day,
      rows: `${Math.max(1, (m.start - first) / 5 + 1)} / ${Math.min(rows + 1, (m.end - first) / 5 + 1)}`,
      time: `${clock(m.start)}–${clock(m.end)} · ${m.room}`,
      once: oneOff(m),
    })),
  );
// a meeting in only a week or two (a tutorial moved for one week) is dated
const oneOff = (m: MeetingView) => (m.weeks.length <= 2 ? `week of ${m.weeks.map((w) => weekOf(year, w)).join(" and ")} only` : "");
// full means no seat for you; the session you already hold is never full
const isFull = (s: SessionView) => s.seatsLeft !== null && s.seatsLeft <= 0 && !s.picked;
function seats(s: SessionView): string {
  if (s.seatsLeft === null) return "capacity not published";
  if (s.picked) return `your seat is held, ${s.seatsLeft} of ${s.capacity} left`;
  return isFull(s) ? "full" : `${s.seatsLeft} of ${s.capacity} seats left`;
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My ANU timetable</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Timetable</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>My ANU timetable <span class="term">{seed.term}</span></h1>

      {error && <p class="notice" role="alert">{error}</p>}

      <div class="layout">
      <section class="week" aria-labelledby="week-heading">
        <h2 id="week-heading">My timetable</h2>
        {
          placements.length === 0 ? (
            <p>Nothing on your timetable yet.</p>
          ) : (
            <div class="grid" style={`--rows: ${rows}; --days: ${days.length}`}>
              <ol class="hours" aria-hidden="true">
                {hours.map((h) => (
                  <li style={`grid-row: ${(h - first) / 5 + 1} / span 12`}>{clock(h)}</li>
                ))}
              </ol>
              {days.map((day) => {
                const { onDay, count } = lanes(day);
                return (
                  <section class="day" aria-labelledby={`day-${day}`}>
                    <h3 id={`day-${day}`}>{DAY_NAMES[day - 1]}</h3>
                    {onDay.length === 0 && <p class="free">Free</p>}
                    {
                      <ol
                        class:list={{ crowded: count > 1 }}
                        style={`--lanes: ${count}`}
                        aria-hidden={onDay.length === 0 ? "true" : undefined}
                        data-day={day}>
                        {onDay.map(({ session: s, meeting: m, clashesWith, lane }) => (
                          <li
                            class:list={["slot", s.activity.mode, { clash: clashesWith.length > 0 }]}
                            data-session={s.id}
                            style={`grid-row: ${(m.start - first) / 5 + 1} / ${(m.end - first) / 5 + 1}; grid-column: ${lane + 1}`}
                          >
                            <strong>{s.title}</strong>
                            <span>
                              {clock(m.start)}–{clock(m.end)} · {m.room}
                            </span>
                            {oneOff(m) && <span class="once">{oneOff(m)}</span>}
                            {clashesWith.length > 0 && (
                              <span class="flag">
                                Clash<span class="sr-only"> with {clashesWith.map((c) => c.title).join(", ")}</span>
                              </span>
                            )}
                          </li>
                        ))}
                      </ol>
                    }
                  </section>
                );
              })}
            </div>
          )
        }
      </section>

      <section class="choose" aria-labelledby="choose-heading">
        <h2 id="choose-heading">Choose your sessions</h2>
        {
          choosing.length === 0 && (
            <p>No courses loaded. Transcribe this term's timetable into <code>src/data/timetable.json</code>.</p>
          )
        }
        {
          choosing.map(({ course, activities }) => (
            <section aria-labelledby={`course-${course.id}`}>
              <h3 id={`course-${course.id}`}>
                {course.code} <span class="course-title">{course.title}</span>
              </h3>
              {activities.map((a) => (
                <form method="post" action="/api/picks" data-picked={a.picked?.id}>
                  <fieldset>
                    <legend>
                      {a.name}
                      {a.picked ? (
                        <span class="state">you're in {a.picked.label}</span>
                      ) : (
                        <span class="state todo">not chosen</span>
                      )}
                    </legend>
                    <ul>
                      {a.sessions.map((s) => {
                        const full = isFull(s);
                        return (
                          <li class:list={{ full, clash: s.clashesWith.length > 0 && !s.picked }}>
                            <input
                              type="radio"
                              name="session"
                              value={s.id}
                              id={`s-${s.id}`}
                              checked={s.picked}
                              disabled={full}
                              required
                              aria-describedby={`d-${s.id}`}
                              data-title={s.title}
                              data-clash={s.clashesWith.length > 0 ? "true" : undefined}
                              data-meetings={preview(s)}
                            />
                            <label for={`s-${s.id}`}>{s.title}</label>
                            <span class="detail" id={`d-${s.id}`}>
                              {s.meetings.map((m) => (
                                <span class="meeting">
                                  {when(m)} · {m.room} · calendar weeks {weekRanges(m.weeks)}
                                </span>
                              ))}
                              <span class="meeting">{seats(s)}</span>
                              {s.clashesWith.length > 0 && (
                                <span class="flag">clashes with {s.clashesWith.map((c) => c.title).join(", ")}</span>
                              )}
                            </span>
                          </li>
                        );
                      })}
                    </ul>
                    <button>{a.picked ? `Swap ${a.name}` : `Choose ${a.name}`}</button>
                  </fieldset>
                </form>
              ))}
            </section>
          ))
        }
        {seed.seats && <p class="note">{seed.seats}</p>}
      </section>
      </div>
    </main>
    {
      seed.source && (
        <footer>
          <p>
            Sessions from the <a href={seed.source.project}>ANU CSSA unofficial timetable</a> (
            <a href="https://creativecommons.org/licenses/by-sa/4.0/">{seed.source.licence}</a>), fetched{" "}
            {seed.source.fetched}; starting picks from {seed.source.allocation}.
          </p>
        </footer>
      )
    }
    <script>
      // A change made in another tab re-renders this one from the database.
      const source = new EventSource("/api/events");
      source.addEventListener("change", () => location.reload());

      // Preview a choice before it's saved: selecting a different session
      // outlines the pick it would replace and draws the new one, faded, in
      // the week. Nothing is stored until the form is submitted.
      type Meeting = { day: number; rows: string; time: string; once: string };

      function clearPreview(form: HTMLFormElement) {
        const picked = form.dataset.picked;
        if (picked) {
          for (const slot of document.querySelectorAll(`.week .slot[data-session="${picked}"]`)) {
            slot.classList.remove("leaving");
          }
        }
        for (const ghost of document.querySelectorAll(`.week .ghost[data-form="${form.dataset.formId}"]`)) {
          ghost.remove();
        }
      }

      function showPreview(form: HTMLFormElement, radio: HTMLInputElement) {
        clearPreview(form);
        const picked = form.dataset.picked;
        if (radio.value === picked) return;
        if (picked) {
          for (const slot of document.querySelectorAll(`.week .slot[data-session="${picked}"]`)) {
            slot.classList.add("leaving");
          }
        }
        const meetings: Meeting[] = JSON.parse(radio.dataset.meetings ?? "[]");
        for (const m of meetings) {
          const day = document.querySelector<HTMLOListElement>(`.week ol[data-day="${m.day}"]`);
          if (!day) continue;
          const ghost = document.createElement("li");
          ghost.className = radio.dataset.clash ? "slot ghost clash" : "slot ghost";
          ghost.dataset.form = form.dataset.formId;
          ghost.style.gridRow = m.rows;
          const title = document.createElement("strong");
          title.textContent = `${radio.dataset.title} (preview)`;
          const time = document.createElement("span");
          time.textContent = m.time;
          ghost.append(title, time);
          if (m.once) {
            const once = document.createElement("span");
            once.className = "once";
            once.textContent = m.once;
            ghost.append(once);
          }
          day.append(ghost);
        }
      }

      document.querySelectorAll<HTMLFormElement>(".choose form").forEach((form, i) => {
        form.dataset.formId = String(i);
        form.addEventListener("change", (event) => {
          const radio = event.target as HTMLInputElement;
          if (radio.type === "radio") showPreview(form, radio);
        });
      });
    </script>
  </body>
</html>
